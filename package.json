{
  "name": "rule-or-drool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reigns-style card swiper where the easy choice now is the ruinous choice later. See TRANSFER.md.",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-content.ts",
    "validate:mvp": "tsx scripts/validate-content.ts --eras all --min-cell 25 --strict",
    "check": "npm run typecheck && npm test && npm run validate",
    "simulate": "tsx scripts/simulate.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
