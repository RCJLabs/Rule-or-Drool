{
  "name": "rule-or-drool",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reigns-style card swiper where the easy choice now is the ruinous choice later. See TRANSFER.md.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run -c vitest.browser.config.ts",
    "check:browser": "npm run build && npm run test:browser",
    "typecheck": "tsc --noEmit",
    "validate": "tsx scripts/validate-content.ts",
    "validate:mvp": "tsx scripts/validate-content.ts --eras all --min-cell 25 --strict",
    "check": "npm run typecheck && npm test && npm run validate:mvp && npm run check:browser",
    "simulate": "tsx scripts/simulate.ts",
    "deck": "tsx scripts/deck.ts",
    "playtests": "tsx scripts/playtests.ts",
    "voice": "tsx scripts/voice.ts",
    "contracts": "tsx scripts/contracts.ts",
    "store:assets": "tsx scripts/store-assets.ts"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
