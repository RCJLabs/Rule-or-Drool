    "right": {
      "label": "Call it your idea",
      "fx": {
        "base": 3,
        "inst": -4,
        "public": -4,
        "order": 2
      },
      "drift": -4
    }
  },
  {
    "id": "mn_restore_queue",
    "type": "event",
    "align": "any",
    "eras": [
      2,
      3
    ],
    "bands": [
      "decay",
      "muddle",
      "ascent"
    ],
    "speaker": "judge",
    "text": "There is a queue outside a building that has not counted anything in years. Nobody organised it and nobody is leaving.",
    "cond": {
      "flags": [
        "elections_abolished"
      ]
    },
    "weight": 3,
    "left": {
      "label": "Let them have their vote",
      "fx": {
        "inst": 6,
        "public": 5,
        "order": -4
      },
      "clearFlags": [
        "elections_abolished"
      ],
      "drift": 6
    },
    "right": {
      "label": "Move the queue along",
      "fx": {
        "order": 4,
        "public": -6,
        "inst": -4,
        "base": 3
      },
      "drift": -6
    }
  },
  {
    "id": "mn_restore_officer",
    "type": "event",
    "align": "any",
    "eras": [
      2,
      3
    ],
    "bands": [
      "decay",
      "muddle",
      "ascent"
    ],
    "speaker": "organizer",
    "text": "The returning officer has kept turning up to an office with nothing in it. She has not resigned and she has not been paid.",
    "cond": {
      "flags": [
        "elections_abolished"
      ]
    },
    "weight": 3,
    "left": {
      "label": "Give her a count",
      "fx": {
        "inst": 5,
        "public": 4,
        "base": -4
      },
      "clearFlags": [
        "elections_abolished"
      ],
      "drift": 5
    },
    "right": {
      "label": "Close the office",
      "fx": {
        "money": 3,
        "inst": -5,
        "public": -4,
        "order": 3
      },
      "drift": -5
    }
  },
  {
    "id": "mn_restore_generals",
    "type": "event",
    "align": "any",
    "eras": [
      2,
      3
    ],
    "bands": [
      "decay",
      "muddle"
    ],
    "speaker": "general",
    "text": "The argument in the room is about who you answer to, and the honest answer is nobody. Two of them find that reassuring and one of them does not.",
    "cond": {
      "flags": [
        "elections_abolished"
      ]
    },
    "weight": 3,
    "left": {
      "label": "Give them an answer",
      "fx": {
        "inst": 6,
        "order": -5,
        "public": 4
      },
      "clearFlags": [
        "elections_abolished"
      ],
      "drift": 6
    },
    "right": {
      "label": "Leave the question open",
      "fx": {
        "order": 5,
        "inst": -5,
        "public": -4,
        "backers": 3
      },
      "drift": -6
    }
  },
  {
    "id": "mn_clean_tempt",
    "type": "event",
    "align": "any",
    "eras": [
      1,
      2,
      3
    ],
    "bands": [
      "decay",
      "muddle",
      "ascent"
    ],
    "speaker": "chief",
    "text": "Two boxes from one district arrived after the count closed. Nobody outside this room knows they exist, and they are the district you needed.",
    "cond": {
      "flags": [
        "mandate_m_clean"
      ],
      "notFlags": [
        "mandate_m_clean_broken",
        "counted_late_boxes"
      ]
