    ],
    "bands": [
      "decay",
      "muddle",
      "ascent"
    ],
    "speaker": "organizer",
    "text": "The cheap win worked, and the country has worked out how it was won. Your volunteers are being asked about it on doorsteps.",
    "weight": 0,
    "left": {
      "label": "Apologise for it",
      "fx": {
        "base": -4,
        "public": 4,
