    "weight": 3,
    "left": {
      "label": "Leave them sealed",
      "fx": {
        "base": -6,
        "backers": -4,
        "inst": 4
      },
      "drift": 6
    },
    "right": {
      "label": "Count them",
      "fx": {
        "base": 5,
        "backers": 4,
        "inst": -5,
        "public": -3
      },
      "drift": -6,
      "setFlags": [
        "counted_late_boxes"
      ]
    }
  },
  {
    "id": "mn_broad_tempt",
    "type": "event",
    "align": "any",
    "eras": [
      1,
      2,
      3
    ],
    "bands": [
      "decay",
      "muddle",
      "ascent"
    ],
    "speaker": "organizer",
    "text": "You can have the vote you need from one of them or the goodwill of the other two. The arithmetic has been checked twice and it does not improve.",
    "cond": {
      "flags": [
        "mandate_m_broad"
      ],
      "notFlags": [
        "mandate_m_broad_broken"
      ]
    },
    "weight": 3,
