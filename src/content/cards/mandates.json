    "align": "any",
    "eras": [
      1,
      2,
      3
    ],
    "bands": [
      "decay",
      "muddle",
      "ascent"
    ],
    "speaker": "spin",
    "text": "A paper that hates you has printed a lie about the water supply, and people are filling their baths. A friend could buy the paper by Friday.",
