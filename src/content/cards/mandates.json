      "fx": {
        "base": 6,
        "backers": 5,
        "public": -9,
        "money": 3
      },
      "drift": -6
    }
  },
  {
    "id": "mn_loyal_tempt",
    "type": "event",
    "align": "any",
    "eras": [
      2,
      3
    ],
    "bands": [
      "decay",
      "muddle",
      "ascent"
    ],
    "speaker": "treasurer",
    "text": "The figures you have been given for two years were wrong the same way every time. The treasurer is not sorry, and will not go unless pushed.",
