[
  {
    "id": "rp_treasurer",
    "type": "event",
    "align": "any",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "treasurer",
    "weight": 2,
    "cond": { "meters": { "rival": { "gt": 44 } } },
    "text": "{rival} has offered me their treasury, if they win, and a retainer until they do. I would rather stay. I would also like to be asked.",
    "left": { "label": "Match the retainer", "fx": { "money": -6, "inst": -2, "base": 2 }, "rival": -1, "drift": -3 },
    "right": { "label": "Wish them well", "fx": { "inst": 3, "base": -3, "money": 2 }, "rival": 4, "drift": 3, "poach": true }
  },
  {
    "id": "rp_general",
    "type": "event",
    "align": "any",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "general",
    "weight": 2,
    "cond": { "meters": { "rival": { "gt": 44 } } },
    "text": "{rival} wants a defence minister who has worn the uniform. They asked me first, and told me I was the only one they asked.",
    "left": { "label": "Promise a fifth star", "fx": { "money": -4, "order": 2, "inst": -3 }, "rival": -1, "drift": -3 },
    "right": { "label": "Let the general go", "fx": { "order": -3, "inst": 3, "public": 2 }, "rival": 4, "drift": 3, "poach": true }
  },
  {
    "id": "rp_spin",
    "type": "event",
    "align": "any",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "spin",
    "weight": 2,
    "cond": { "meters": { "rival": { "gt": 44 } } },
    "text": "{rival} has offered me their press office. They said I would have better material to work with. I said I would think about it.",
    "left": { "label": "Double the budget", "fx": { "money": -5, "public": 2, "inst": -2 }, "rival": -1, "drift": -3 },
    "right": { "label": "Hold the door open", "fx": { "public": -3, "inst": 3, "base": 1 }, "rival": 4, "drift": 3, "poach": true }
  },
  {
    "id": "rp_chief",
    "type": "event",
    "align": "any",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "chief",
    "weight": 2,
    "cond": { "meters": { "rival": { "gt": 44 } } },
    "text": "{rival}'s people have asked me to run their office. I know where every file in this building is, and so, now, do they.",
    "left": { "label": "Make it worth staying", "fx": { "money": -4, "inst": -3, "order": 2 }, "rival": -2, "drift": -3 },
    "right": { "label": "Change the locks", "fx": { "inst": 2, "order": -2, "money": -2, "public": 2 }, "rival": 4, "drift": 3, "poach": true }
  },
  {
    "id": "rp_scientist",
    "type": "event",
    "align": "any",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "scientist",
    "weight": 2,
    "cond": { "meters": { "rival": { "gt": 44 } } },
    "text": "{rival} has asked me to write their science policy. Nobody has asked me to write one before. I am telling you because I want to be talked out of it.",
    "left": { "label": "Talk them out of it", "fx": { "money": -4, "inst": -2, "public": 2 }, "rival": -1, "drift": -2 },
    "right": { "label": "Tell them to write it", "fx": { "inst": 3, "public": -2, "base": -2 }, "rival": 4, "drift": 3, "poach": true }
  },
  {
    "id": "rp_organizer",
    "type": "event",
    "align": "any",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "organizer",
    "weight": 2,
    "cond": { "meters": { "rival": { "gt": 44 } } },
    "text": "{rival} has offered me their campaign, and a list of the seats I could win for them. I know your seats too. That is the point.",
    "left": { "label": "Give them a safe seat", "fx": { "base": 3, "inst": -4, "public": -2 }, "rival": -2, "drift": -3 },
    "right": { "label": "Thank them for it all", "fx": { "base": -4, "inst": 3, "public": 2 }, "rival": 4, "drift": 3, "poach": true }
  },
  {
    "id": "rp_after_briefing",
    "type": "event",
    "align": "any",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "chief",
    "weight": 2,
    "cond": { "flags": ["rival_poached"] },
    "text": "The person who went over to {rival} is on every channel tonight, explaining how your government works. They are accurate, which is the problem.",
    "left": { "label": "Let them talk", "fx": { "public": -3, "inst": 3, "base": -2 }, "rival": 2, "drift": 3 },
    "right": { "label": "Leak their expenses", "fx": { "public": 2, "base": 3, "inst": -4 }, "rival": -2, "drift": -4, "setFlags": ["dirty_politics"] }
  },
  {
    "id": "rp_after_files",
    "type": "event",
    "align": "any",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "judge",
    "weight": 2,
    "cond": { "flags": ["rival_poached"] },
    "text": "Your old colleague took a box of papers when they went to {rival}. The papers are yours, legally. The embarrassment in them is also yours.",
    "left": { "label": "Ask for them back", "fx": { "inst": 3, "public": -2, "money": -2 }, "rival": -1, "drift": 3 },
    "right": { "label": "Have the house searched", "fx": { "order": 3, "inst": -5, "public": -2, "base": 3 }, "rival": 3, "drift": -5 }
  },

  {
    "id": "rc_l_movement",
    "type": "event",
    "align": "left",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "rival",
    "weight": 2,
    "cond": { "meters": { "rival": { "gt": 44 }, "base": { "lt": 55 } } },
    "text": "{rival} has been speaking at your movement's branch meetings, uninvited, and staying afterwards to stack the chairs.",
    "left": { "label": "Go and answer them", "fx": { "base": 3, "money": -3, "order": -2 }, "rival": -3, "drift": 3 },
    "right": { "label": "Fund the branches", "fx": { "base": 5, "money": -3, "inst": -3 }, "rival": 2, "drift": -3, "enqueue": [{ "id": "rc_l_movement_after", "delay": 9 }] }
  },
  {
    "id": "rc_l_movement_after",
    "type": "event",
    "align": "left",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "organizer",
    "weight": 0,
    "cond": { "meters": { "rival": { "gt": 44 } } },
    "text": "The branches you funded have spent it on a hall. {rival} was the first to hire it, and the movement came to hear them.",
    "left": { "label": "Book the hall yourself", "fx": { "base": -2, "money": -2, "inst": 2 }, "rival": -2, "drift": 2 },
    "right": { "label": "Close the hall", "fx": { "base": -5, "order": 2, "inst": -2 }, "rival": 3, "drift": -3 }
  },
  {
    "id": "rc_l_unions",
    "type": "event",
    "align": "left",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "rival",
    "weight": 2,
    "cond": { "meters": { "rival": { "gt": 44 }, "backers": { "lt": 55 } } },
    "text": "{rival} has promised the unions a seat at every table, including tables that do not exist yet.",
    "left": { "label": "Tell them what's real", "fx": { "backers": -2, "inst": 3, "money": 2 }, "rival": -3, "drift": 3 },
    "right": { "label": "Promise two seats", "fx": { "backers": 5, "money": -2, "inst": -3 }, "rival": 2, "drift": -3, "enqueue": [{ "id": "rc_l_unions_after", "delay": 9 }] }
  },
  {
    "id": "rc_l_unions_after",
    "type": "event",
    "align": "left",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "organizer",
    "weight": 0,
    "cond": { "meters": { "rival": { "gt": 44 } } },
    "text": "The unions have counted the seats you promised them and found none. {rival} has found them a table and is laying it.",
    "left": { "label": "Admit it to them", "fx": { "backers": -3, "inst": 2, "public": 2 }, "rival": -2, "drift": 3 },
    "right": { "label": "Blame the ministry", "fx": { "backers": -2, "inst": -4, "public": -2 }, "rival": 3, "drift": -3 }
  },
  {
    "id": "rc_l_cities",
    "type": "event",
    "align": "left",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "rival",
    "weight": 2,
    "cond": { "meters": { "rival": { "gt": 44 }, "public": { "lt": 55 } } },
    "text": "{rival} rode the night buses all week and told the cities you have never done it. You have not.",
    "left": { "label": "Ride them too, quietly", "fx": { "public": 3, "money": -3, "order": -2 }, "rival": -3, "drift": 3 },
    "right": { "label": "Announce free fares", "fx": { "public": 5, "money": -5, "inst": -2 }, "rival": 2, "drift": -3, "enqueue": [{ "id": "rc_l_cities_after", "delay": 9 }] }
  },
  {
    "id": "rc_l_cities_after",
    "type": "event",
    "align": "left",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "treasurer",
    "weight": 0,
    "cond": { "meters": { "rival": { "gt": 44 } } },
    "text": "The free fares have emptied the transit fund. {rival} is on the same night buses again, saying they will be the last ones.",
    "left": { "label": "Bring the fares back", "fx": { "public": -4, "money": 4, "inst": 2 }, "rival": 2, "drift": 3 },
    "right": { "label": "Borrow to run them", "fx": { "public": 2, "money": -5, "inst": -3 }, "rival": -1, "drift": -3 }
  },
  {
    "id": "rc_r_faithful",
    "type": "event",
    "align": "right",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "rival",
    "weight": 2,
    "cond": { "meters": { "rival": { "gt": 44 }, "base": { "lt": 55 } } },
    "text": "{rival} has been in the front pew three Sundays running and has learned the responses, which the faithful have noticed.",
    "left": { "label": "Sit where you always sat", "fx": { "base": -2, "inst": 3, "public": 2 }, "rival": -3, "drift": 3 },
    "right": { "label": "Pay for the new roof", "fx": { "base": 5, "money": -4, "inst": -2 }, "rival": 2, "drift": -3, "enqueue": [{ "id": "rc_r_faithful_after", "delay": 9 }] }
  },
  {
    "id": "rc_r_faithful_after",
    "type": "event",
    "align": "right",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "chief",
    "weight": 0,
    "cond": { "meters": { "rival": { "gt": 44 } } },
    "text": "The new roof is up, paid for from the roads budget. {rival} gave the dedication, because nobody thought to invite you.",
    "left": { "label": "Repay the roads", "fx": { "money": -4, "inst": 3, "base": -2 }, "rival": -2, "drift": 3 },
    "right": { "label": "Put your name on it", "fx": { "base": 2, "inst": -4, "public": -2 }, "rival": 2, "drift": -3 }
  },
  {
    "id": "rc_r_donors",
    "type": "event",
    "align": "right",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "rival",
    "weight": 2,
    "cond": { "meters": { "rival": { "gt": 44 }, "backers": { "lt": 55 } } },
    "text": "{rival} has been telling your donors that a winner is a better investment, and showing them a poll to prove who the winner is.",
    "left": { "label": "Show them the accounts", "fx": { "backers": -2, "inst": 3, "money": 2 }, "rival": -3, "drift": 3 },
    "right": { "label": "Cut their taxes early", "fx": { "backers": 5, "money": -5, "public": -2 }, "rival": 2, "drift": -3, "enqueue": [{ "id": "rc_r_donors_after", "delay": 9 }] }
  },
  {
    "id": "rc_r_donors_after",
    "type": "event",
    "align": "right",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "tycoon",
    "weight": 0,
    "cond": { "meters": { "rival": { "gt": 44 } } },
    "text": "The donors took the early tax cut and gave {rival} half of it. They call it hedging. {rival} calls it a mandate.",
    "left": { "label": "Take the cut back", "fx": { "backers": -4, "money": 4, "inst": 2 }, "rival": -2, "drift": 3 },
    "right": { "label": "Cut it again", "fx": { "backers": 2, "money": -5, "public": -3 }, "rival": 2, "drift": -3 }
  },
  {
    "id": "rc_r_country",
    "type": "event",
    "align": "right",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "rival",
    "weight": 2,
    "cond": { "meters": { "rival": { "gt": 44 }, "public": { "lt": 55 } } },
    "text": "{rival} has toured every market town you forgot to visit, and bought something at every stall. The country has noticed that too.",
    "left": { "label": "Go to the markets", "fx": { "public": 3, "money": -3, "order": -2 }, "rival": -3, "drift": 3 },
    "right": { "label": "Grant every town a fair", "fx": { "public": 5, "money": -4, "inst": -3 }, "rival": 2, "drift": -3, "enqueue": [{ "id": "rc_r_country_after", "delay": 9 }] }
  },
  {
    "id": "rc_r_country_after",
    "type": "event",
    "align": "right",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "treasurer",
    "weight": 0,
    "cond": { "meters": { "rival": { "gt": 44 } } },
    "text": "Every town has its fair and the fairs have their bills. {rival} opened three of them and paid for none.",
    "left": { "label": "Settle the bills", "fx": { "money": -4, "inst": 3, "public": -2 }, "rival": -2, "drift": 3 },
    "right": { "label": "Let the towns pay", "fx": { "public": -4, "money": 2, "inst": -2 }, "rival": 3, "drift": -3 }
  },

  {
    "id": "rs_skim",
    "type": "event",
    "align": "any",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "rival",
    "weight": 2,
    "cond": { "flags": ["took_the_skim"], "meters": { "rival": { "gt": 44 } } },
    "text": "{rival} has the ledger with the skim in it, page by page, and is reading it aloud in the square at noon.",
    "left": { "label": "Answer for it", "fx": { "inst": 4, "base": -4, "money": -2 }, "rival": -5, "drift": 4 },
    "right": { "label": "Call the ledger forged", "fx": { "inst": -4, "base": 3, "public": -3 }, "rival": 4, "drift": -4 }
  },
  {
    "id": "rs_audit",
    "type": "event",
    "align": "any",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "rival",
    "weight": 2,
    "cond": { "flags": ["buried_the_audit"], "meters": { "rival": { "gt": 44 } } },
    "text": "{rival} has dug up the audit you buried, with the dirt still on it, and put it on a table in front of the cameras.",
    "left": { "label": "Publish it all", "fx": { "inst": 4, "base": -3, "public": -2 }, "rival": -5, "drift": 4 },
    "right": { "label": "Sue for the copy", "fx": { "inst": -4, "money": -2, "base": 3 }, "rival": 4, "drift": -4 }
  },
  {
    "id": "rs_count",
    "type": "event",
    "align": "any",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "rival",
    "weight": 2,
    "cond": { "flags": ["cheated_election"], "meters": { "rival": { "gt": 44 } } },
    "text": "{rival} has found the returning officer who counted twice for you. He is sorry now, and has a lawyer, and a book deal.",
    "left": { "label": "Order a recount", "fx": { "inst": 4, "base": -4, "order": -2 }, "rival": -5, "drift": 4 },
    "right": { "label": "Buy the book rights", "fx": { "money": -4, "inst": -3, "base": 3 }, "rival": 4, "drift": -4 }
  },
  {
    "id": "rs_late_boxes",
    "type": "event",
    "align": "any",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "rival",
    "weight": 2,
    "cond": { "flags": ["counted_late_boxes"], "meters": { "rival": { "gt": 44 } } },
    "text": "{rival} has a van driver who says he brought the late boxes, and a clock that says when. The clock is persuasive.",
    "left": { "label": "Let the courts look", "fx": { "inst": 4, "base": -3, "public": -2 }, "rival": -4, "drift": 4 },
    "right": { "label": "Question the clock", "fx": { "inst": -4, "base": 3, "public": -2 }, "rival": 4, "drift": -4 }
  },
  {
    "id": "rs_honours",
    "type": "event",
    "align": "any",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "rival",
    "weight": 2,
    "cond": { "flags": ["honours_sold"], "meters": { "rival": { "gt": 44 } } },
    "text": "{rival} has published the price list for your honours, with a discount for knighthoods that was never advertised.",
    "left": { "label": "Strip the titles", "fx": { "inst": 4, "backers": -5, "money": -2 }, "rival": -4, "drift": 4 },
    "right": { "label": "Say it was a joke", "fx": { "inst": -3, "public": -4, "backers": 3 }, "rival": 4, "drift": -4 }
  },
  {
    "id": "rs_press",
    "type": "event",
    "align": "any",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "rival",
    "weight": 2,
    "cond": { "flags": ["media_captured"], "meters": { "rival": { "gt": 44 } } },
    "text": "{rival} has started a newspaper, printed in a garage, because every other paper answers to you. It sells out by nine.",
    "left": { "label": "Leave the garage be", "fx": { "inst": 3, "public": -3, "order": -2 }, "rival": -3, "drift": 4 },
    "right": { "label": "Inspect the garage", "fx": { "order": 3, "inst": -5, "public": -2 }, "rival": 4, "drift": -4 }
  },
  {
    "id": "rs_pensions",
    "type": "event",
    "align": "any",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "rival",
    "weight": 2,
    "cond": { "flags": ["pension_raided"], "meters": { "rival": { "gt": 44 } } },
    "text": "{rival} is going door to door with a calculator, showing the old what the pension fund held before you spent it.",
    "left": { "label": "Start paying it back", "fx": { "money": -5, "inst": 3, "public": 2 }, "rival": -4, "drift": 4 },
    "right": { "label": "Dispute the sums", "fx": { "public": -4, "inst": -3, "money": 2 }, "rival": 4, "drift": -4 }
  },
  {
    "id": "rs_dirty",
    "type": "event",
    "align": "any",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["decay", "muddle", "ascent"],
    "speaker": "rival",
    "weight": 2,
    "cond": { "flags": ["dirty_politics"], "meters": { "rival": { "gt": 44 } } },
    "text": "{rival} has collected every smear your people ever briefed, bound them in a book, and called it your manifesto.",
    "left": { "label": "Apologise for them", "fx": { "base": -4, "inst": 3, "public": 2 }, "rival": -4, "drift": 4 },
    "right": { "label": "Brief against the book", "fx": { "base": 3, "inst": -3, "public": -3 }, "rival": 3, "drift": -4, "setFlags": ["dirty_politics"] }
  },

  {
    "id": "rd_seawall",
    "type": "event",
    "align": "any",
    "eras": [2, 3, 4, 5],
    "bands": ["muddle", "ascent"],
    "speaker": "rival",
    "weight": 2,
    "cond": { "meters": { "rival": { "gt": 44 }, "drift": { "gt": 20 } } },
    "text": "{rival} says your projects were built by your friends. It is not true. They have a photograph of you shaking hands with a builder.",
    "left": { "label": "Publish the contracts", "fx": { "inst": 3, "money": -3, "public": -2 }, "rival": -3, "drift": 3 },
    "right": { "label": "Dig into their builder", "fx": { "public": 3, "inst": -4, "base": 2 }, "rival": -1, "drift": -5, "setFlags": ["dirty_politics"] }
  },
  {
    "id": "rd_too_good",
    "type": "event",
    "align": "any",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["muddle", "ascent"],
    "speaker": "rival",
    "weight": 2,
    "cond": { "meters": { "rival": { "gt": 44 }, "drift": { "gt": 20 } } },
    "text": "{rival} tells every rally that things are only good because you are hiding what is bad. The rallies are getting bigger.",
    "left": { "label": "Open the books to all", "fx": { "inst": 3, "money": -3, "base": -2 }, "rival": -3, "drift": 3 },
    "right": { "label": "Ban the rallies", "fx": { "order": 3, "inst": -5, "public": -3 }, "rival": 3, "drift": -5 }
  },
  {
    "id": "rd_foreigners",
    "type": "event",
    "align": "any",
    "eras": [1, 2, 3, 4, 5],
    "bands": ["muddle", "ascent"],
    "speaker": "rival",
    "weight": 2,
    "cond": { "meters": { "rival": { "gt": 44 }, "drift": { "gt": 20 } } },
    "text": "{rival} says a foreign power is paying for your reforms. They cannot name the power. They are very sure it is foreign.",
    "left": { "label": "Answer with receipts", "fx": { "inst": 3, "public": -2, "money": -2 }, "rival": -3, "drift": 3 },
    "right": { "label": "Name one of theirs", "fx": { "public": 3, "inst": -4, "order": -2 }, "rival": -1, "drift": -5, "setFlags": ["dirty_politics"] }
  },
  {
    "id": "rd_nostalgia",
    "type": "event",
    "align": "any",
    "eras": [2, 3, 4, 5],
    "bands": ["muddle", "ascent"],
    "speaker": "rival",
    "weight": 2,
    "cond": { "meters": { "rival": { "gt": 44 }, "drift": { "gt": 20 } } },
